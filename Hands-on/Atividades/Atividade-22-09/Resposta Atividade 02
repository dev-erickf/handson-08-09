package atividade.rafaela;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        System.out.print("Informe o primeiro número inteiro: ");
        int numero1 = entrada.nextInt();

        System.out.print("Informe o segundo número inteiro: ");
        int numero2 = entrada.nextInt();

        System.out.printf("O primeiro número informado foi: %d%n", numero1);
        System.out.printf("O segundo número informado foi: %d%n", numero2);

        if (numero1 == numero2) {
            System.out.println("Os números são iguais.");

        } else if (numero1 > numero2) {
            System.out.println("O número " + numero1 + " é maior que o número " + numero2 + ".");

        } else {
            System.out.println("O número " + numero2 + " é maior que o número " + numero1 + ".");
        }
          
        entrada.close();

    }
    
}
