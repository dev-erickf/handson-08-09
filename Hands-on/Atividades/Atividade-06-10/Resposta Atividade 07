package atividade.rafaela;

import java.util.Scanner;
import java.util.Locale;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        double salario;
        double somaSalarios = 0;
        int somaFilhos = 0;
        int pessoas = 0;
        int ate100 = 0;
        double maiorSalario = 0;

        System.out.print("Digite o salário (negativo para parar): ");
        salario = entrada.nextDouble();

        while (salario >= 0) {
            System.out.print("Digite o número de filhos: ");
            int filhos = entrada.nextInt();

            somaSalarios += salario;
            somaFilhos += filhos;
            pessoas++;

            if (pessoas == 1 || salario > maiorSalario) {
                maiorSalario = salario;
            }

            if (salario <= 100) {
                ate100++;
            }

            System.out.print("Digite o salário (negativo para parar): ");
            salario = entrada.nextDouble();
        }

        if (pessoas == 0) {
            System.out.println("Nenhum habitante foi informado.");
        } else {
            System.out.printf(Locale.US,
                    "Média salarial: R$ %.2f%n",
                    somaSalarios / pessoas);

            System.out.printf(Locale.US,
                    "Média de filhos: %.2f%n",
                    (double) somaFilhos / pessoas);

            System.out.printf(Locale.US,
                    "Maior salário: R$ %.2f%n",
                    maiorSalario);

            System.out.printf(Locale.US,
                    "Percentual com salário de até R$ 100,00: %.2f%%%n",
                    (double) ate100 / pessoas * 100);
        }

        entrada.close();
    }
}
