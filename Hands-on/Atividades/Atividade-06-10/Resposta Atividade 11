package atividade.rafaela;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        for (int i = 1; i <= 20; i++) {
            int n;

            do {
                System.out.print("Digite o " + i + "º número positivo: ");
                n = entrada.nextInt();
            } while (n <= 0);

            for (int j = 1; j <= n; j++) {
                System.out.println(j + " x " + n + " = " + (j * n));
            }

            System.out.println();
        }

        entrada.close();
    }
}
