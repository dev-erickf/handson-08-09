package atividade.rafaela;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int n;

        do {
            System.out.print("Digite um número inteiro positivo : ");
            n = entrada.nextInt();
        } while (n <= 0);

        long soma = 0;

        for (int i = 1; i <= n; i++) {
            soma += i;
        }

        System.out.println("Soma = " + soma);

        entrada.close();
    }
}
