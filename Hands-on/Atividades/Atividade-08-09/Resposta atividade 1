programa {
  funcao inicio() {
   inteiro numero, antecessor, sucessor

   // Número antecessor é sucessor.

    escreva("Digite um número inteiro para saber o sucessor e antecessor dele: ")
     leia(numero)

   antecessor = numero - 1
   sucessor = numero + 1

   escreva("O antecessor é = ", antecessor, " | O sucessor é = ", sucessor)
  }
}
