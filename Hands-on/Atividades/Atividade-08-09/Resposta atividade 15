programa {
  funcao inicio() {

    //  Leia uma variável lógica e mostre seu valor negado(Operador NÃO).
    
    logico valor, resultado

		escreva("Digite o valor (sim ou nao): ")
		leia(valor)

		resultado = nao valor

		escreva("Valor negado: ", resultado)
  }
}
