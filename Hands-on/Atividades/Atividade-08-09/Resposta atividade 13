programa {
  funcao inicio() {

    //  Crie duas variáveis lógicas `a` e `b`. Leia os valores e mostre o resultado de `a e b` (Operador E).

    logico a, b, resultado

		escreva("Digite o valor de a (verdadeiro ou falso): ")
		leia(a)

		escreva("Digite o valor de b (verdadeiro ou falso): ")
		leia(b)

		resultado = a e b

		escreva("Resultado de a e b: ", resultado)
  }
}
