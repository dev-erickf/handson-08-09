package atividade.mark;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

         System.out.print("Informe o número de eleitores: ");
        int eleitores = entrada.nextInt();

        System.out.print("Informe o número de votos do primeiro candidato: ");
        int votosPrimeiro = entrada.nextInt();

        System.out.print("Informe o número de votos do segundo candidato: ");
        int votosSegundo = entrada.nextInt();

        int votosNulos = eleitores - votosPrimeiro - votosSegundo;

        double percentualPrimeiro = (double) votosPrimeiro / eleitores * 100;
        double percentualSegundo = (double) votosSegundo / eleitores * 100;
        double percentualNulos = (double) votosNulos / eleitores * 100;

        System.out.printf("Percentual de votos do primeiro candidato: %.2f%%%n", percentualPrimeiro);
        System.out.printf("Percentual de votos do segundo candidato: %.2f%%%n", percentualSegundo);
        System.out.printf("Percentual de votos nulos: %.2f%%%n", percentualNulos);

        entrada.close();

    }
    
}
