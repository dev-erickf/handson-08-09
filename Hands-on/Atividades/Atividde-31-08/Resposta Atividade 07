package atividade.mark;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

       System.out.print("Informe quanto custa o salário mínimo: ");
        double salarioMinimo = entrada.nextDouble();

        System.out.print("Informe o valor do seu salário: ");
        double salario = entrada.nextDouble();

        double quantidadeSalariosMinimos = salario / salarioMinimo;

        System.out.printf("Você recebe %.2f salários mínimos.%n", quantidadeSalariosMinimos);

        entrada.close();

    }

}
