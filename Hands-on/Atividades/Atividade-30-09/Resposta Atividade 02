package atividade.rafaela;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        System.out.println(" ===== STREAMING ===== ");
        System.out.println("1 - Netflix");
        System.out.println("2 - Disney+");
        System.out.println("3 - Prime Video");
        System.out.println("4 - Spotify");
        System.out.println("5 - Sair");
        System.out.print("Escolha uma opção: ");
        int opcao = entrada.nextInt();

        switch (opcao) {
            case 1:
                System.out.println("Você escolheu Netflix.");
                System.out.println("Prepare a pipoca e aproveite seus filmes e séries favoritos!");
                break;
            case 2:
                System.out.println("Você escolheu Disney+.");
                System.out.println("Aproveite seus conteúdos favoritos da Disney!");
                break;
            case 3:
                System.out.println("Você escolheu Prime Video.");
                System.out.println("Aproveite seus filmes e séries favoritos!");
                break;
            case 4:
                System.out.println("Você escolheu Spotify.");
                System.out.println("Aproveite sua música favorita!");
                break;
            case 5:
                System.out.println("Saindo do programa...");
                break;
            default:
                System.out.println("Opção inválida. Por favor, escolha uma opção válida.");
        }
        
        entrada.close();
    }
}
