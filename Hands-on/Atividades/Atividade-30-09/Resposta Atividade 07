package atividade.rafaela;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int opcao;
        int estudante;
        double total = 0;
        double desconto = 0;
        double valorFinal;

        do {
            System.out.println("===== LANCHONETE =====");
            System.out.println();
            System.out.println("1 - Pizza         - R$ 30,00");
            System.out.println("2 - Hambúrguer    - R$ 20,00");
            System.out.println("3 - Batata        - R$ 12,00");
            System.out.println("4 - Refrigerante  - R$ 8,00");
            System.out.println("0 - Finalizar");

            System.out.print("Escolha seu pedido:");
            opcao = entrada.nextInt();

            if (opcao == 1) {
                total = total + 30;
                System.out.println("Pizza - R$ 30,00");

            } else if (opcao == 2) {
                total = total + 20;
                System.out.println("Hambúrguer - R$ 20,00");

            } else if (opcao == 3) {
                total = total + 12;
                System.out.println("Batata - R$ 12,00");

            } else if (opcao == 4) {
                total = total + 8;
                System.out.println("Refrigerante - R$ 8,00");

            } else if (opcao != 0) {
                System.out.println("Opção inválida.");
            }

            System.out.println("Total do pedido: R$ " + total);
            System.out.println();

        } while (opcao != 0);

        System.out.println("Pedido finalizado.");
        System.out.printf("Valor total: R$ %.2f%n", total);

        if (total < 50) {
            System.out.println("Sem desconto.");
            desconto = 0;

        } else if (total >= 50 && total <= 99) {
            System.out.println("5% de desconto.");
            desconto = total * 0.05;

        } else {
            System.out.println("Você é estudante?");
            System.out.println("1 - Sim");
            System.out.println("2 - Não");
            estudante = entrada.nextInt();

            while (estudante != 1 && estudante != 2) {
                System.out.println("Opção inválida. Digite 1 para Sim ou 2 para Não.");
                estudante = entrada.nextInt();
            }

            if (estudante == 1) {
                System.out.println("15% de desconto.");
                desconto = total * 0.15;
            } else {
                System.out.println("10% de desconto.");
                desconto = total * 0.10;
            }
        }

        valorFinal = total - desconto;

        System.out.printf("Desconto: R$ %.2f%n", desconto);
        System.out.printf("Valor final: R$ %.2f%n", valorFinal);

        entrada.close();
    }
}
