package atividade.rafaela;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] numeros = new int[10];

        for (int i = 0; i < 10; i++) {
            System.out.print("Digite o " + (i + 1) + "º número: ");
            numeros[i] = entrada.nextInt();
        }

        System.out.println("\nNúmeros primos e suas posições:");

        for (int i = 0; i < 10; i++) {
            boolean primo = true;

            if (numeros[i] < 2) {
                primo = false;
            } else {
                for (int j = 2; j < numeros[i]; j++) {
                    if (numeros[i] % j == 0) {
                        primo = false;
                        break;
                    }
                }
            }

            if (primo) {
                System.out.println(
                    "Número primo: " + numeros[i]
                    + " | Posição: " + i
                );
            }
        }

        entrada.close();
    }
}
