package atividade.rafaela;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] numeros = new int[6];
        int somaPares = 0;
        int quantidadeImpares = 0;

        for (int i = 0; i < numeros.length; i++) {
            System.out.print("Digite o " + (i + 1) + "º numero: ");
            numeros[i] = entrada.nextInt();
        }

        System.out.print("\nNumeros pares: ");
        boolean encontrouPar = false;

        for (int i = 0; i < numeros.length; i++) {
            if (numeros[i] % 2 == 0) {
                if (encontrouPar) {
                    System.out.print(", ");
                }

                System.out.print(numeros[i]);
                somaPares += numeros[i];
                encontrouPar = true;
            }
        }

        if (!encontrouPar) {
            System.out.print("Nenhum");
        }

        System.out.println();
        System.out.println("Soma dos numeros pares: " + somaPares);

        System.out.print("Numeros impares: ");
        boolean encontrouImpar = false;

        for (int i = 0; i < numeros.length; i++) {
            if (numeros[i] % 2 != 0) {
                if (encontrouImpar) {
                    System.out.print(", ");
                }

                System.out.print(numeros[i]);
                quantidadeImpares++;
                encontrouImpar = true;
            }
        }

        if (!encontrouImpar) {
            System.out.print("Nenhum");
        }

        System.out.println();
        System.out.println("Quantidade de numeros impares: "
                + quantidadeImpares);

        entrada.close();
    }
}
